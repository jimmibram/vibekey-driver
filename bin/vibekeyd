#!/usr/bin/env python3
"""vibekeyd: Ulanzi Vibekey (AU05) driver for the Omarchy Vibekey plugin.

What it does
  * Finds the Vibekey dongle (USB fff1:00dd) and holds both of its raw HID
    channels open. The dongle reboots every ~4 s when nothing holds them.
  * Reads the standard HID reports straight from hidraw, so the Voice key is
    seen too: it sends the HID "ErrorRollOver" usage (0x01), which the kernel
    treats as an error state and never turns into a key press.
  * Grabs the device's evdev nodes (EVIOCGRAB) so its factory keystrokes
    (Enter, Esc, PrintScreen, arrows, Backspace) no longer reach the
    compositor. Every control runs the action assigned to it in
    ~/.config/omarchy/vibekey/config.json instead.
  * Polls the battery over the vendor channel (TEA-encrypted frames, see
    MrCroxx/olanzi docs) and publishes everything the panel needs to
    $XDG_RUNTIME_DIR/vibekey/state.json.

Only the Python standard library is used.

Usage: vibekeyd [--probe] [--no-grab] [--no-battery]
  --probe       also print every decoded control event to stdout
  --no-grab     leave the evdev nodes alone (keystrokes reach apps as well)
  --no-battery  never talk to the vendor channel
"""

import errno
import fcntl
import json
import os
import select
import shlex
import signal
import struct
import subprocess
import sys
import time

VENDOR_ID = 0xFFF1
PRODUCT_ID = 0x00DD
PRODUCT_NAME = "Ulanzi Vibekey"

CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "omarchy", "vibekey")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
SEEN_PATH = os.path.join(CONFIG_DIR, "seen.json")
RUNTIME_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "vibekey")
STATE_PATH = os.path.join(RUNTIME_DIR, "state.json")
LOCK_PATH = os.path.join(RUNTIME_DIR, "lock")

EVIOCGRAB = 0x40044590
INPUT_EVENT_SIZE = struct.calcsize("llHHi")

BATTERY_INTERVAL = 60.0
PREVIEW_PATH = os.path.join(RUNTIME_DIR, "preview")   # the panel heartbeats "open" here while shown
PREVIEW_MAX_AGE = 6.0
RESCAN_INTERVAL = 0.7  # the dongle reboots every ~4 s until something holds it open
CONFIG_POLL = 0.5

# --------------------------------------------------------------------------
# HID usage names
# --------------------------------------------------------------------------

KEYBOARD_USAGES = {0x01: "Voice"}  # ErrorRollOver: what the Voice key sends from the factory
for _i, _c in enumerate("abcdefghijklmnopqrstuvwxyz"):
    KEYBOARD_USAGES[0x04 + _i] = _c.upper()
for _i, _c in enumerate("1234567890"):
    KEYBOARD_USAGES[0x1E + _i] = _c
KEYBOARD_USAGES.update({
    0x28: "Enter", 0x29: "Escape", 0x2A: "Backspace", 0x2B: "Tab", 0x2C: "Space",
    0x2D: "Minus", 0x2E: "Equal", 0x2F: "LeftBracket", 0x30: "RightBracket",
    0x31: "Backslash", 0x32: "Hash", 0x33: "Semicolon", 0x34: "Apostrophe",
    0x35: "Grave", 0x36: "Comma", 0x37: "Period", 0x38: "Slash", 0x39: "CapsLock",
    0x46: "PrintScreen", 0x47: "ScrollLock", 0x48: "Pause", 0x49: "Insert",
    0x4A: "Home", 0x4B: "PageUp", 0x4C: "Delete", 0x4D: "End", 0x4E: "PageDown",
    0x4F: "Right", 0x50: "Left", 0x51: "Down", 0x52: "Up", 0x53: "NumLock",
    0x54: "KP/", 0x55: "KP*", 0x56: "KP-", 0x57: "KP+", 0x58: "KPEnter",
    0x62: "KP0", 0x63: "KP.", 0x65: "Menu", 0x66: "Power", 0x74: "Execute",
    0x75: "Help", 0x76: "Menu", 0x77: "Select", 0x78: "Stop", 0x79: "Again",
    0x7A: "Undo", 0x7B: "Cut", 0x7C: "Copy", 0x7D: "Paste", 0x7E: "Find",
    0x7F: "Mute", 0x80: "VolumeUp", 0x81: "VolumeDown",
})
for _i in range(12):
    KEYBOARD_USAGES[0x3A + _i] = "F%d" % (_i + 1)
    KEYBOARD_USAGES[0x68 + _i] = "F%d" % (_i + 13)
for _i in range(9):
    KEYBOARD_USAGES[0x59 + _i] = "KP%d" % (_i + 1)

MODIFIER_BITS = [(0x01, "ctrl"), (0x02, "shift"), (0x04, "alt"), (0x08, "super"),
                 (0x10, "ctrl"), (0x20, "shift"), (0x40, "alt"), (0x80, "super")]

CONSUMER_USAGES = {
    0x00B5: "NextTrack", 0x00B6: "PreviousTrack", 0x00B7: "Stop", 0x00B8: "Eject",
    0x00CD: "PlayPause", 0x00E2: "Mute", 0x00E9: "VolumeUp", 0x00EA: "VolumeDown",
    0x006F: "BrightnessUp", 0x0070: "BrightnessDown", 0x0183: "MediaPlayer",
    0x018A: "Mail", 0x0192: "Calculator", 0x0194: "FileBrowser", 0x0221: "Search",
    0x0223: "Browser", 0x0224: "Back", 0x0225: "Forward", 0x0226: "StopLoading",
    0x0227: "Refresh", 0x022A: "Bookmarks",
}

# The six physical controls and the HID usages they send from the factory.
# Knob rotation has been seen both as arrow keys and as mouse wheel ticks.
DEFAULT_SLOTS = {
    "kbd:0x01": "key1",
    "kbd:0x28": "key2",
