#!/usr/bin/env python3
"""vibekey-config: edit ~/.config/omarchy/vibekey/config.json safely.

Usage:
  vibekey-config show
  vibekey-config set-button <control> <json-object | null>
  vibekey-config set <key> <json-value>
  vibekey-config alias <raw-id> <slot | null>     say which physical control a raw id is
  vibekey-config forget <raw-id>                  drop a raw id from seen.json

<control> is a slot name (key1, key2, key3, knob, knob_right, knob_left) or a
raw control id the daemon reported (kbd:0x68, con:0x00e9, wheel:cw, ...).
A button object may carry: label, command, keys, release_command, release_keys.
Writes are atomic; the running daemon picks the change up within a second.
"""

import json
import os
import sys

CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "omarchy", "vibekey")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
SEEN_PATH = os.path.join(CONFIG_DIR, "seen.json")
SLOTS = ("key1", "key2", "key3", "knob", "knob_right", "knob_left")

ALLOWED_BUTTON_KEYS = {"label", "command", "keys", "release_command", "release_keys", "preset", "scroll"}


def load():
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError:
        data = {}
    except (OSError, ValueError) as error:
        sys.exit("vibekey-config: cannot read %s: %s" % (CONFIG_PATH, error))
    if not isinstance(data, dict):
        data = {}
    if not isinstance(data.get("buttons"), dict):
        data["buttons"] = {}
    data.setdefault("grab", True)
    data.setdefault("battery", True)
    if not isinstance(data.get("aliases"), dict):
        data["aliases"] = {}
    return data


def save(data):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = CONFIG_PATH + ".tmp.%d" % os.getpid()
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(data, handle, indent=2, sort_keys=True)
        handle.write("\n")
    os.replace(tmp, CONFIG_PATH)


def parse_json(text):
    try:
        return json.loads(text)
    except ValueError as error:
        sys.exit("vibekey-config: invalid JSON: %s" % error)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    command = argv[0]
    data = load()
    if command == "show":
        print(json.dumps(data, indent=2, sort_keys=True))
        return 0
    if command == "set-button" and len(argv) == 3:
        control = argv[1].strip()
        value = parse_json(argv[2])
        if not control:
            sys.exit("vibekey-config: empty control name")
        if value is None:
            data["buttons"].pop(control, None)
        elif isinstance(value, dict):
            cleaned = {k: v for k, v in value.items() if k in ALLOWED_BUTTON_KEYS and isinstance(v, str)}
            if cleaned:
                data["buttons"][control] = cleaned
            else:
                data["buttons"].pop(control, None)
        else:
            sys.exit("vibekey-config: button value must be a JSON object or null")
        save(data)
        return 0
    if command == "alias" and len(argv) == 3:
        raw_id, slot = argv[1].strip(), argv[2].strip()
        if slot in ("null", "none", ""):
            data["aliases"].pop(raw_id, None)
        elif slot in SLOTS:
            data["aliases"][raw_id] = slot
        else:
            sys.exit("vibekey-config: slot must be one of " + ", ".join(SLOTS))
        save(data)
        return 0
    if command == "forget" and len(argv) == 2:
        try:
            with open(SEEN_PATH, "r", encoding="utf-8") as handle:
                seen = json.load(handle)
        except (OSError, ValueError):
            return 0
        if isinstance(seen, dict) and isinstance(seen.get("controls"), dict):
            seen["controls"].pop(argv[1].strip(), None)
            tmp = SEEN_PATH + ".tmp.%d" % os.getpid()
            with open(tmp, "w", encoding="utf-8") as handle:
                json.dump(seen, handle, indent=2, sort_keys=True)
                handle.write("\n")
            os.replace(tmp, SEEN_PATH)
        return 0
    if command == "set" and len(argv) == 3:
        key = argv[1].strip()
        if key in ("", "buttons"):
            sys.exit("vibekey-config: use set-button for buttons")
        data[key] = parse_json(argv[2])
        save(data)
        return 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
