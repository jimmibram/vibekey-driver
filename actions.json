{
  "version": 1,
  "presets": [
    {
      "id": "dictation_ptt",
      "label": "Push-to-talk dictation",
      "description": "Hold to record, release to transcribe (voxtype)",
      "command": "voxtype record start",
      "release_command": "voxtype record stop"
    },
    {
      "id": "dictation_toggle",
      "label": "Toggle dictation",
      "description": "voxtype record toggle",
      "command": "voxtype record toggle"
    },
    {
      "id": "dictation_cancel",
      "label": "Cancel dictation",
      "description": "Discard the current recording (voxtype)",
      "command": "voxtype record cancel"
    },
    {
      "id": "key_enter",
      "label": "Press Enter",
      "description": "Confirm, like the factory setting",
      "keys": "Return"
    },
    {
      "id": "key_escape",
      "label": "Press Escape",
      "description": "Cancel, like the factory setting",
      "keys": "Escape"
    },
    {
      "id": "key_tab",
      "label": "Press Tab",
      "description": "Keys: Tab",
      "keys": "Tab"
    },
    {
      "id": "key_shift_tab",
      "label": "Press Shift+Tab",
      "description": "Cycle Claude Code modes",
      "keys": "shift+Tab"
    },
    {
      "id": "key_ctrl_c",
      "label": "Press Ctrl+C",
      "description": "Interrupt the running agent",
      "keys": "ctrl+c"
    },
    {
      "id": "key_ctrl_enter",
      "label": "Press Ctrl+Enter",
      "description": "Keys: ctrl+Return",
      "keys": "ctrl+Return"
    },
    {
      "id": "key_up",
      "label": "Press Up",
      "description": "Keys: Up",
      "keys": "Up"
    },
    {
      "id": "key_down",
      "label": "Press Down",
      "description": "Keys: Down",
      "keys": "Down"
    },
    {
      "id": "agent",
      "label": "Open coding agent",
      "description": "omarchy agent",
      "command": "omarchy agent"
    },
    {
      "id": "terminal",
      "label": "Open terminal",
      "description": "omarchy launch terminal",
      "command": "omarchy launch terminal"
    },
    {
      "id": "browser",
      "label": "Open browser",
      "description": "omarchy launch browser",
      "command": "omarchy launch browser"
    },
    {
      "id": "herdr_next",
      "label": "Next agent in herdr",
      "description": "Flip to the next coding agent in your open herdr (local or remote)",
      "command": "\"$HOME/.config/omarchy/plugins/jimmibram.vibekey/bin/vibekey-herdr-agent\" next"
    },
    {
      "id": "herdr_prev",
      "label": "Previous agent in herdr",
      "description": "Flip to the previous coding agent in your open herdr",
      "command": "\"$HOME/.config/omarchy/plugins/jimmibram.vibekey/bin/vibekey-herdr-agent\" prev"
    },
    {
      "id": "herdr_open",
      "label": "Open herdr",
      "description": "omarchy launch terminal herdr",
      "command": "omarchy launch terminal herdr"
    },
    {
      "id": "menu",
      "label": "Omarchy menu",
      "description": "omarchy-menu toggle",
      "command": "omarchy-menu toggle"
    },
    {
      "id": "menu_apps",
      "label": "Apps menu",
      "description": "omarchy-menu toggle apps",
      "command": "omarchy-menu toggle apps"
    },
    {
      "id": "menu_system",
      "label": "System menu",
      "description": "omarchy-menu toggle system",
      "command": "omarchy-menu toggle system"
    },
    {
      "id": "clipboard",
      "label": "Clipboard manager",
      "description": "omarchy-shell shell toggle omarchy.clipboard",
      "command": "omarchy-shell shell toggle omarchy.clipboard"
    },
    {
      "id": "emojis",
      "label": "Emoji picker",
      "description": "omarchy-shell shell toggle omarchy.emojis",
      "command": "omarchy-shell shell toggle omarchy.emojis"
    },
    {
      "id": "audio_panel",
      "label": "Audio panel",
      "description": "omarchy-shell shell toggle omarchy.audio",
      "command": "omarchy-shell shell toggle omarchy.audio"
    },
    {
      "id": "volume_up",
      "label": "Volume up",
      "description": "omarchy-audio-output-volume raise",
      "command": "omarchy-audio-output-volume raise"
    },
    {
      "id": "volume_down",
      "label": "Volume down",
      "description": "omarchy-audio-output-volume lower",
      "command": "omarchy-audio-output-volume lower"
    },
    {
      "id": "volume_mute",
      "label": "Mute / unmute",
      "description": "omarchy-audio-output-volume mute-toggle",
      "command": "omarchy-audio-output-volume mute-toggle"
    },
    {
      "id": "mic_mute",
      "label": "Mute / unmute microphone",
      "description": "omarchy-audio-input-mute",
      "command": "omarchy-audio-input-mute"
    },
    {
      "id": "audio_switch",
      "label": "Switch audio output",
      "description": "omarchy-audio-output-switch",
      "command": "omarchy-audio-output-switch"
    },
    {
      "id": "media_play",
      "label": "Play / pause",
      "description": "omarchy-shell media playPause",
      "command": "omarchy-shell media playPause"
    },
    {
      "id": "media_next",
      "label": "Next track",
      "description": "omarchy-shell media next",
      "command": "omarchy-shell media next"
    },
    {
      "id": "media_prev",
      "label": "Previous track",
      "description": "omarchy-shell media previous",
      "command": "omarchy-shell media previous"
    },
    {
      "id": "brightness_up",
      "label": "Brightness up",
      "description": "omarchy-brightness-display +5%",
      "command": "omarchy-brightness-display +5%"
    },
    {
      "id": "brightness_down",
      "label": "Brightness down",
      "description": "omarchy-brightness-display 5%-",
      "command": "omarchy-brightness-display 5%-"
    },
    {
      "id": "screenshot",
      "label": "Screenshot",
      "description": "omarchy-capture-screenshot",
      "command": "omarchy-capture-screenshot"
    },
    {
      "id": "screenrecord",
      "label": "Start / stop screen recording",
      "description": "omarchy capture screenrecording",
      "command": "omarchy-capture-screenrecording --stop-recording || omarchy-menu toggle trigger.capture.screenrecord"
    },
    {
      "id": "capture_text",
      "label": "Copy text from screen (OCR)",
      "description": "omarchy capture text",
      "command": "omarchy capture text"
    },
    {
      "id": "color_picker",
      "label": "Color picker",
      "description": "hyprpicker -a",
      "command": "pkill hyprpicker || hyprpicker -a"
    },
    {
      "id": "workspace_next",
      "label": "Next workspace",
      "description": "hyprctl dispatch workspace m+1",
      "command": "hyprctl dispatch workspace m+1"
    },
    {
      "id": "workspace_prev",
      "label": "Previous workspace",
      "description": "hyprctl dispatch workspace m-1",
      "command": "hyprctl dispatch workspace m-1"
    },
    {
      "id": "window_next",
      "label": "Focus next window",
      "description": "hyprctl dispatch cyclenext",
      "command": "hyprctl dispatch cyclenext"
    },
    {
      "id": "window_close",
      "label": "Close window",
      "description": "hyprctl dispatch killactive",
      "command": "hyprctl dispatch killactive"
    },
    {
      "id": "window_fullscreen",
      "label": "Toggle full screen",
      "description": "hyprctl dispatch fullscreen",
      "command": "hyprctl dispatch fullscreen"
    },
    {
      "id": "window_float",
      "label": "Toggle floating",
      "description": "hyprctl dispatch togglefloating",
      "command": "hyprctl dispatch togglefloating"
    },
    {
      "id": "scratchpad",
      "label": "Toggle scratchpad",
      "description": "hyprctl dispatch togglespecialworkspace scratchpad",
      "command": "hyprctl dispatch togglespecialworkspace scratchpad"
    },
    {
      "id": "notification_dismiss",
      "label": "Dismiss last notification",
      "description": "omarchy-shell notifications dismissOne",
      "command": "omarchy-shell notifications dismissOne"
    },
    {
      "id": "notification_history",
      "label": "Notification history",
      "description": "omarchy-shell notifications showHistory",
      "command": "omarchy-shell notifications showHistory"
    },
    {
      "id": "nightlight",
      "label": "Toggle night light",
      "description": "omarchy toggle nightlight",
      "command": "omarchy toggle nightlight"
    },
    {
      "id": "theme_next",
      "label": "Next theme",
      "description": "omarchy theme next",
      "command": "omarchy theme next"
    },
    {
      "id": "lock",
      "label": "Lock screen",
      "description": "omarchy system lock",
      "command": "omarchy system lock"
    }
  ],
  "knob_turn": [
    {
      "id": "scroll",
      "label": "Scroll",
      "description": "Right scrolls down, left scrolls up, like a mouse wheel",
      "right": {
        "scroll": "down"
      },
      "left": {
        "scroll": "up"
      }
    },
    {
      "id": "volume",
      "label": "Volume",
      "description": "Right louder, left quieter",
      "right": {
        "command": "omarchy-audio-output-volume raise"
      },
      "left": {
        "command": "omarchy-audio-output-volume lower"
      }
    },
    {
      "id": "brightness",
      "label": "Screen brightness",
      "description": "Right brighter, left dimmer",
      "right": {
        "command": "omarchy-brightness-display +5%"
      },
      "left": {
        "command": "omarchy-brightness-display 5%-"
      }
    },
    {
      "id": "workspaces",
      "label": "Workspaces",
      "description": "Right next workspace, left previous",
      "right": {
        "command": "hyprctl dispatch workspace m+1"
      },
      "left": {
        "command": "hyprctl dispatch workspace m-1"
      }
    },
    {
      "id": "herdr_agents",
      "label": "Agents in herdr",
      "description": "Flip between coding agents in your open herdr",
      "right": {
        "command": "\"$HOME/.config/omarchy/plugins/jimmibram.vibekey/bin/vibekey-herdr-agent\" next"
      },
      "left": {
        "command": "\"$HOME/.config/omarchy/plugins/jimmibram.vibekey/bin/vibekey-herdr-agent\" prev"
      }
    },
    {
      "id": "windows",
      "label": "Windows",
      "description": "Cycle through the windows on this workspace",
      "right": {
        "command": "hyprctl dispatch cyclenext"
      },
      "left": {
        "command": "hyprctl dispatch cyclenext prev"
      }
    },
    {
      "id": "tabs",
      "label": "Browser or editor tabs",
      "description": "Ctrl+Tab and Ctrl+Shift+Tab",
      "right": {
        "keys": "ctrl+Tab"
      },
      "left": {
        "keys": "ctrl+shift+Tab"
      }
    },
    {
      "id": "arrows_updown",
      "label": "Up and down arrows",
      "description": "Move through lists and menus",
      "right": {
        "keys": "Down"
      },
      "left": {
        "keys": "Up"
      }
    },
    {
      "id": "arrows_leftright",
      "label": "Left and right arrows",
      "description": "Move the cursor sideways",
      "right": {
        "keys": "Right"
      },
      "left": {
        "keys": "Left"
      }
    },
    {
      "id": "media",
      "label": "Media tracks",
      "description": "Right next track, left previous",
      "right": {
        "command": "omarchy-shell media next"
      },
      "left": {
        "command": "omarchy-shell media previous"
      }
    },
    {
      "id": "zoom",
      "label": "Zoom",
      "description": "Ctrl+Plus and Ctrl+Minus",
      "right": {
        "keys": "ctrl+plus"
      },
      "left": {
        "keys": "ctrl+minus"
      }
    },
    {
      "id": "undo_redo",
      "label": "Undo and redo",
      "description": "Left undoes, right redoes",
      "right": {
        "keys": "ctrl+shift+z"
      },
      "left": {
        "keys": "ctrl+z"
      }
    }
  ]
}
